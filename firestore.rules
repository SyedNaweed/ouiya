rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPhoneVerified() {
      return isSignedIn() 
          && request.auth.token.phone_number != null 
          && request.auth.token.phone_number != '';
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin != null && request.auth.token.admin == true) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@youroffersanddeals\\.com$'))
      );
    }

    // ─────────────────────────────────────────────────────────────────────
    // Users collection
    // ─────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true; // Public directory info (business profile details)
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId) || isAdmin();

      // User subcollections
      match /favourites/{favId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /favouriteShops/{shopId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cart/{cartId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Offers collection
    // ─────────────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Shops / Business collection
    // ─────────────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Reviews collection (Top level)
    // ─────────────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // Coupons collection
    // ─────────────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if isSignedIn() || true; // Public verification allowed, full read for signed in
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Categories, Brands, Banners, Promo Banners, Hotspots
    // ─────────────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /promo_banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /hotspots/{hotspotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /convenience_fees/{feeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Ad Campaigns & Slots
    // ─────────────────────────────────────────────────────────────────────
    match /ad_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /ad_slots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Tourist Destinations / Discover Pondicherry
    // ─────────────────────────────────────────────────────────────────────
    match /tourist_destinations/{destinationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Chats & Chat Messages
    // ─────────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Notifications collection
    // ─────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

